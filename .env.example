# The production Node server serves both the API/socket and the built client.
PORT=3001
NODE_ENV=production
# Explicitly list every browser origin that may connect, including its port.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173
# Omit DATABASE_URL for the local atomic JSON store.
# DATABASE_URL=postgres://arena:change-this-password@localhost:5432/arena
DATA_FILE=data/arena.json
# Docker PostgreSQL credentials (set a strong password before deployment).
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
# Public deployment: DNS name pointing to your VPS, used by Caddy.
DOMAIN=arena.example.com
